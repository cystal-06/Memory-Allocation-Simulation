{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc build active file",
            "command": "/bin/bash",
            "args": [
                "-c",
                "gcc -Wall -Wextra -std=c99 main.c memory_manager.c -o memory_sim && ./memory_sim"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}